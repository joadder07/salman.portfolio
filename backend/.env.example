# Server Port & Environment
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Setup:
# Local Development (SQLite):
DATABASE_URL="file:./dev.db"
# Production Database (e.g. MongoDB Atlas / PostgreSQL):
# DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.siud2tz.mongodb.net/portfolio?retryWrites=true&w=majority"

# JWT Authentication Secrets (min 16 characters)
JWT_SECRET="super_secret_jwt_access_token_key_change_in_production_123"
JWT_REFRESH_SECRET="super_secret_jwt_refresh_token_key_change_in_production_456"

# Initial Admin Credentials (used during npm run seed)
ADMIN_EMAIL=admin@portfolio.com
ADMIN_PASSWORD=Admin@123456

# Cloudinary Storage Configuration
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
